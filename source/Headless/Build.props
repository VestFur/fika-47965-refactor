<Project>

	<!-- csharp version -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<!-- use author info from AssemblyInfo.cs -->
	<PropertyGroup>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="../Properties/AssemblyInfo.cs" />
	</ItemGroup>

	<PropertyGroup>
		<GameDir Condition="'$(GameDir)' == ''">$(MSBuildThisFileDirectory)..\..\SPT5.0</GameDir>
		<BepInExCore>$(GameDir)/BepInEx/core</BepInExCore>
		<Interop>$(GameDir)/BepInEx/interop</Interop>
		<SptPlugins>$(GameDir)/BepInEx/plugins/sptushonka</SptPlugins>
	</PropertyGroup>

</Project>
