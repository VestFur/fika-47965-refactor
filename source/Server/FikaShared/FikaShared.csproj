<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Parallel builds use per-agent tags (obj-<tag>/bin-<tag>). The SDK only excludes the
         paths of the current build, so any other obj-*/bin-* tree in this folder would be
         compiled into this one and fail with CS0579 "TargetFrameworkAttribute duplicated".
         Keep every tagged intermediate and output tree out of the compile set (same line as
         Client/Fika.Core/Fika.Core.csproj). -->
    <Compile Remove="obj*/**;bin*/**" />
  </ItemGroup>

</Project>
