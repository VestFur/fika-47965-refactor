<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>FikaServer</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Library</OutputType>
		<Version>2.4.1</Version>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<EnableDefaultContentItems>false</EnableDefaultContentItems>
		<NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>

		<!-- LiteNetLib requires unsafe blocks-->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- Keep build-machine paths out of the shipped symbols so server side
		     stack traces read "FikaServer\Overrides\..." instead of the
		     absolute path of whichever checkout produced the assembly. -->
		<PathMap>$(MSBuildProjectDirectory)=FikaServer</PathMap>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="$(SptRuntimeDir)\SPTarkov.*.dll" Private="false" />
		<Reference Include="$(SptRuntimeDir)\0Harmony.dll" Private="false" />
		<Reference Include="$(SptRuntimeDir)\MonoMod.*.dll" Private="false" />
		<Reference Include="$(SptRuntimeDir)\Mono.Cecil.dll" Private="false" />
		<Reference Include="$(SptRuntimeDir)\MudBlazor.dll" Private="false" />
		<Reference Include="$(SptRuntimeDir)\SemanticVersioning.dll" Private="false" />
		<Reference Include="$(SptRuntimeDir)\Spectre.Console*.dll" Private="false" />
	</ItemGroup>

	<ItemGroup>
    <Content Include="assets\**">
    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
	
	
  <Target Name="ValidateSptRuntime" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(SptRuntimeDir)\SPTarkov.Server.Core.dll')" Text="SPT 5.0 runtime missing. Pass -p:GameDir=path-to-game." />
  </Target>
	
	
  <ItemGroup>
    <ProjectReference Include="..\FikaShared\FikaShared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Parallel builds use per-agent tags (obj-<tag>/bin-<tag>). The SDK only excludes the
         paths of the current build, so any other obj-*/bin-* tree in this folder would be
         compiled into this one and fail with CS0579 "TargetFrameworkAttribute duplicated".
         Keep every tagged intermediate and output tree out of the compile set. -->
    <Compile Remove="obj*/**;bin*/**" />
  </ItemGroup>
	
	
  <ItemGroup>
    <Folder Include="Overrides\Routers\" />
  </ItemGroup>
</Project>
